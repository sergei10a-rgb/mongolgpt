#!/usr/bin/env bash
set -euo pipefail
APP=mongolgpt

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
MongolGPT суулгагч

Хэрэглээ: install.sh [сонголтууд]

Сонголтууд:
    -h, --help              Энэ тусламжийг харуулах
    -v, --version <хувилбар> Тодорхой хувилбар суулгах (жишээ нь 1.0.180)
    -b, --binary <зам>      Татаж авахын оронд дотоод гүйцэтгэх файлаас суулгах
        --no-modify-path    Shell тохиргооны файлуудыг өөрчлөхгүй (.zshrc, .bashrc гэх мэт)

Жишээ:
    curl -fsSL https://raw.githubusercontent.com/sergei10a-rgb/mongolgpt/main/install | bash
    curl -fsSL https://raw.githubusercontent.com/sergei10a-rgb/mongolgpt/main/install | bash -s -- --version 1.0.180
    ./install --binary /path/to/mongolgpt
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""
install_name="$APP"
release_tag=""

valid_release_version() {
    [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]]
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Алдаа: --version-д хувилбарын утга шаардлагатай${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Алдаа: --binary-д гүйцэтгэх файлын зам шаардлагатай${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Анхааруулга: Үл мэдэгдэх сонголт '$1'${NC}" >&2
            shift
            ;;
    esac
done

INSTALL_DIR=$HOME/.mongolgpt/bin
mkdir -p "$INSTALL_DIR"

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Алдаа: ${binary_path} замд гүйцэтгэх файл олдсонгүй${NC}"
        exit 1
    fi
    if [[ "$binary_path" == *.exe ]]; then
      install_name="$APP.exe"
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac
    if [ "$os" = "windows" ]; then
      install_name="$APP.exe"
    fi

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64|windows-arm64)
        ;;
      *)
        echo -e "${RED}Дэмжигдээгүй үйлдлийн систем эсвэл архитектур: $os/$arch${NC}"
        exit 1
        ;;
    esac

    archive_ext=".zip"
    if [ "$os" = "linux" ]; then
      archive_ext=".tar.gz"
    fi

    is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi

      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        if ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "windows" ]; then
        ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
        out=""
        if command -v powershell.exe >/dev/null 2>&1; then
          out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        elif command -v pwsh >/dev/null 2>&1; then
          out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        fi
        out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [ "$out" != "true" ] && [ "$out" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    filename="$APP-$target$archive_ext"


    if [ "$os" = "linux" ]; then
        if ! command -v tar >/dev/null 2>&1; then
             echo -e "${RED}Алдаа: 'tar' шаардлагатай боловч суулгагдаагүй байна.${NC}"
             exit 1
        fi
    else
        if ! command -v unzip >/dev/null 2>&1; then
            echo -e "${RED}Алдаа: 'unzip' шаардлагатай боловч суулгагдаагүй байна.${NC}"
            exit 1
        fi
    fi

    if [ -z "$requested_version" ]; then
        latest_release=$(curl -fsSL https://api.github.com/repos/sergei10a-rgb/mongolgpt/releases/latest || true)
        tag_name=$(echo "$latest_release" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')
        release_tag="$tag_name"
        specific_version="${tag_name#mongolgpt-}"
        specific_version="${specific_version#v}"

        if [ "$release_tag" != "mongolgpt-v${specific_version}" ] || ! valid_release_version "$specific_version"; then
            echo -e "${RED}Хувилбарын мэдээллийг татаж чадсангүй${NC}"
            exit 1
        fi
        url="https://github.com/sergei10a-rgb/mongolgpt/releases/download/${release_tag}/$filename"
    else
        # Strip leading product/prefix markers if present
        requested_version="${requested_version#mongolgpt-}"
        requested_version="${requested_version#v}"
        if ! valid_release_version "$requested_version"; then
            echo -e "${RED}Алдаа: Хувилбарын формат буруу байна: ${requested_version}${NC}"
            exit 1
        fi
        specific_version=$requested_version

        # Verify the release exists before downloading
        release_tag=""
        for candidate in "mongolgpt-v${requested_version}" "v${requested_version}"; do
            http_status=$(curl -sI -o /dev/null -w "%{http_code}" "https://github.com/sergei10a-rgb/mongolgpt/releases/tag/${candidate}")
            if [ "$http_status" != "404" ]; then
                release_tag="$candidate"
                break
            fi
        done
        if [ -z "$release_tag" ]; then
            echo -e "${RED}Алдаа: mongolgpt-v${requested_version} хувилбар олдсонгүй${NC}"
            echo -e "${MUTED}Гарсан хувилбарууд: https://github.com/sergei10a-rgb/mongolgpt/releases${NC}"
            exit 1
        fi
        url="https://github.com/sergei10a-rgb/mongolgpt/releases/download/${release_tag}/$filename"
    fi
fi

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

check_version() {
    if command -v mongolgpt >/dev/null 2>&1; then
        mongolgpt_path=$(which mongolgpt)

        ## Check the installed version
        installed_version=$(mongolgpt --version 2>/dev/null || echo "")

        if [[ "$installed_version" != "$specific_version" ]]; then
            print_message info "${MUTED}Суулгасан хувилбар: ${NC}$installed_version."
        else
            print_message info "${MUTED}$specific_version хувилбар аль хэдийн суусан байна${NC}"
            exit 0
        fi
    fi
}

unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    local tmp_dir=${TMPDIR:-/tmp}
    local basename="${tmp_dir}/mongolgpt_install_$$"
    local tracefile="${basename}.trace"

    rm -f "$tracefile"
    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap "trap - RETURN; rm -f \"$tracefile\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    (
        curl --trace-ascii "$tracefile" -s -f -L -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done
    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

checksum_for_file() {
    local archive_path="$1"

    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$archive_path" | awk '{print tolower($1)}'
        return 0
    fi

    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$archive_path" | awk '{print tolower($1)}'
        return 0
    fi

    if command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$archive_path" | sed 's/^.*= //' | tr '[:upper:]' '[:lower:]'
        return 0
    fi

    if command -v certutil.exe >/dev/null 2>&1 || command -v certutil >/dev/null 2>&1; then
        local certutil_bin="certutil.exe"
        if ! command -v certutil.exe >/dev/null 2>&1; then
            certutil_bin="certutil"
        fi

        local cert_path="$archive_path"
        if command -v cygpath >/dev/null 2>&1; then
            cert_path=$(cygpath -w "$archive_path")
        fi

        "$certutil_bin" -hashfile "$cert_path" SHA256 \
            | tr -d ' \r' \
            | grep -E '^[0-9a-fA-F]{64}$' \
            | sed -n '1p' \
            | tr '[:upper:]' '[:lower:]'
        return 0
    fi

    return 1
}

verify_download_integrity() {
    local archive_path="$1"
    local checksum_path="$2"

    if [ ! -f "$checksum_path" ]; then
        echo -e "${RED}Алдаа: Release checksum файл олдсонгүй.${NC}"
        exit 1
    fi

    local expected_hashes
    expected_hashes=$(
        awk -v file="$filename" \
            'NF == 2 && length($1) == 64 && $1 ~ /^[0-9a-fA-F]+$/ && $2 == file { print tolower($1) }' \
            "$checksum_path"
    )
    if [ -z "$expected_hashes" ]; then
        echo -e "${RED}Алдаа: ${filename} архивын checksum бичлэг release дотор алга байна.${NC}"
        exit 1
    fi

    local expected_hash_count
    expected_hash_count=$(printf "%s\n" "$expected_hashes" | sed '/^$/d' | wc -l | tr -d '[:space:]')
    if [ "$expected_hash_count" != "1" ]; then
        echo -e "${RED}Алдаа: ${filename} архивын checksum бичлэг тодорхой бус байна.${NC}"
        exit 1
    fi

    local expected_hash
    expected_hash=$(printf "%s\n" "$expected_hashes" | sed -n '1p')

    local actual_hash=""
    if ! actual_hash=$(checksum_for_file "$archive_path"); then
        echo -e "${RED}Алдаа: SHA-256 баталгаажуулах хэрэгсэл олдсонгүй. sha256sum, shasum, openssl эсвэл certutil шаардлагатай.${NC}"
        exit 1
    fi

    actual_hash=$(printf "%s" "$actual_hash" | tr -d '\r\n[:space:]' | tr '[:upper:]' '[:lower:]')
    if ! printf "%s" "$actual_hash" | grep -Eq '^[0-9a-f]{64}$'; then
        echo -e "${RED}Алдаа: SHA-256 checksum баталгаажуулж чадсангүй.${NC}"
        exit 1
    fi

    if [ "$actual_hash" != "$expected_hash" ]; then
        echo -e "${RED}Алдаа: Татсан архивын checksum release дээрх SHA256SUMS-тэй таарахгүй байна.${NC}"
        exit 1
    fi
}

legacy_release_checksum() {
    [ "$release_tag" = "mongolgpt-v0.1.1" ] || return 1

    case "$filename" in
        mongolgpt-darwin-arm64.zip) echo "0a64287398cedbfb3b6213a5cd5ca523ed0ca2457277545c67f89c45b6426397" ;;
        mongolgpt-darwin-x64-baseline.zip) echo "83e1ba9182f4a4b19326e9e8bd93cc740d223e555c31ba60ed7f4526dbc87bd9" ;;
        mongolgpt-darwin-x64.zip) echo "4f6f80662787073ff2eb822aebde181bdfd9673aa72ff72035daf2a4f2170580" ;;
        mongolgpt-linux-arm64-musl.tar.gz) echo "b0d579de90bc9987b5c295e7e2c7eb9fa40a7ced1aa3d9e4f446d0f2a9960cec" ;;
        mongolgpt-linux-arm64.tar.gz) echo "8d450551aa18afbf01100176974c3db9b5fa6e29dba3885070127f4ecb721e03" ;;
        mongolgpt-linux-x64-baseline-musl.tar.gz) echo "c2d97c9908b9b4948e2d8ba52f84fca25bba438e24b5a037e386a8c3d0500b0d" ;;
        mongolgpt-linux-x64-baseline.tar.gz) echo "3baa7379df50af70f06a5f51e9a8e315b1b69083ae8e67b19adb41bfe3d4a201" ;;
        mongolgpt-linux-x64-musl.tar.gz) echo "bfd64e9372cdba3f8b5f4a51f5c1c19386771453272268f8ed5334e8166d40f1" ;;
        mongolgpt-linux-x64.tar.gz) echo "a6906f984dd0dedba431c886e7d88412c8d925a9c52474a3a7bfe5e7df3d111f" ;;
        mongolgpt-windows-arm64.zip) echo "43da990f7ed71e6fbda5c910125126207e54536a29435c138f56dd55a6a62b75" ;;
        mongolgpt-windows-x64-baseline.zip) echo "2675f67a68085de5d97f54c39b66a9fd7ceb29e4106ffeb806fd3276b84fa042" ;;
        mongolgpt-windows-x64.zip) echo "3cfe43da00faeab5d7e2625405f07bb7b1cf946b30a5e6bbe02af32118c3c429" ;;
        *) return 1 ;;
    esac
}

download_and_install() {
    print_message info "\n${MUTED}Суулгаж байна: ${NC}mongolgpt ${MUTED}хувилбар: ${NC}$specific_version"
    local tmp_dir
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/mongolgpt_install.XXXXXXXXXX")
    local archive_path="$tmp_dir/$filename"
    local checksum_path="$tmp_dir/SHA256SUMS"
    local checksum_url="https://github.com/sergei10a-rgb/mongolgpt/releases/download/${release_tag}/SHA256SUMS"
    mkdir -p "$tmp_dir"

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$archive_path"; then
        # Fallback to standard curl on Windows, non-TTY environments, or if custom progress fails
        curl -# -f -L -o "$archive_path" "$url"
    fi

    if ! curl -# -f -L -o "$checksum_path" "$checksum_url"; then
        local legacy_checksum=""
        legacy_checksum=$(legacy_release_checksum || true)
        if [ -z "$legacy_checksum" ]; then
            echo -e "${RED}Алдаа: Release checksum файлыг татаж чадсангүй.${NC}"
            exit 1
        fi
        # v0.1.1 predates the checksum asset; pin its GitHub-published archive digests for a safe migration.
        printf "%s  %s\n" "$legacy_checksum" "$filename" > "$checksum_path"
    fi
    verify_download_integrity "$archive_path" "$checksum_path"

    if [ "$os" = "linux" ]; then
        tar -xzf "$archive_path" -C "$tmp_dir"
    else
        unzip -q "$archive_path" -d "$tmp_dir"
    fi

    mv "$tmp_dir/$install_name" "$INSTALL_DIR/$install_name"
    chmod 755 "${INSTALL_DIR}/$install_name"
    rm -rf "$tmp_dir"
}

install_from_binary() {
    print_message info "\n${MUTED}Суулгаж байна: ${NC}mongolgpt ${MUTED}эх үүсвэр: ${NC}$binary_path"
    cp "$binary_path" "${INSTALL_DIR}/$install_name"
    chmod 755 "${INSTALL_DIR}/$install_name"
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi


add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "$config_file дотор команд аль хэдийн байна, бичихийг алгаслаа."
    elif [[ -w $config_file ]]; then
        echo -e "\n# mongolgpt" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}mongolgpt-ийг ${NC}\$PATH ${MUTED}хувьсагчид амжилттай нэмлээ: ${NC}$config_file"
    else
        print_message warning "$config_file (эсвэл түүнтэй адил файлд) уг хавтсыг гараар нэмнэ үү:"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "$current_shell-д тохирох тохиргооны файл олдсонгүй. PATH-д дараахыг гараар нэмэх шаардлагатай байж болно:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            ash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "$config_file (эсвэл түүнтэй адил файлд) уг хавтсыг гараар нэмнэ үү:"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> $GITHUB_PATH
    print_message info "$INSTALL_DIR-ийг \$GITHUB_PATH-д нэмлээ"
fi

echo -e ""
echo -e "${MUTED}Mongol${NC}GPT"
echo -e ""
echo -e "${MUTED}MongolGPT үнэгүй загваруудтай. Эхлэхийн тулд:${NC}"
echo -e ""
echo -e "cd <төслийн-хавтас>  ${MUTED}# Хавтас нээх${NC}"
echo -e "mongolgpt      ${MUTED}# Команд ажиллуулах${NC}"
echo -e ""
echo -e "${MUTED}Дэлгэрэнгүй баримт: ${NC}https://docs.mgpt.mn/docs/"
echo -e ""
echo -e ""

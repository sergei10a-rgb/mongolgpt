{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/sergei10a-rgb/mongolgpt/main/packages/web/public/desktop-theme.json",
  "title": "MongolGPT Desktop сэдэв",
  "description": "MongolGPT Desktop програмын сэдвийн тодорхойлолт",
  "type": "object",
  "required": ["name", "id", "light", "dark"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON схемийн лавлагаа"
    },
    "name": {
      "type": "string",
      "description": "Хүнд уншихад ойлгомжтой сэдвийн нэр"
    },
    "id": {
      "type": "string",
      "description": "Сэдвийн давтагдашгүй танигч (slug)",
      "pattern": "^[a-z0-9-]+$"
    },
    "light": {
      "$ref": "#/definitions/ThemeVariant",
      "description": "Цайвар горимын өнгөний хувилбар"
    },
    "dark": {
      "$ref": "#/definitions/ThemeVariant",
      "description": "Бараан горимын өнгөний хувилбар"
    }
  },
  "definitions": {
    "HexColor": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "#fff, #ffff, #ffffff эсвэл #ffffffff хэлбэрийн Hex өнгөний утга"
    },
    "ColorValue": {
      "type": "string",
      "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|var\\(--[a-z0-9-]+\\))$",
      "description": "Hex өнгөний утга (#rgb/#rgba/#rrggbb/#rrggbbaa) эсвэл CSS хувьсагчийн лавлагаа"
    },
    "ThemeSeedColors": {
      "type": "object",
      "description": "Сэдэв үүсгэхэд ашигладаг хуучин утгын үрийн багц",
      "additionalProperties": false,
      "required": ["neutral", "primary", "success", "warning", "error", "info", "interactive", "diffAdd", "diffDelete"],
      "properties": {
        "neutral": {
          "$ref": "#/definitions/HexColor",
          "description": "Саарал өнгийн шатлал үүсгэх үндсэн саармаг өнгө"
        },
        "primary": {
          "$ref": "#/definitions/HexColor",
          "description": "Үндсэн брэндийн/тодотголын өнгө"
        },
        "success": {
          "$ref": "#/definitions/HexColor",
          "description": "Амжилтын төлөвийн өнгө (ихэвчлэн ногоон)"
        },
        "warning": {
          "$ref": "#/definitions/HexColor",
          "description": "Анхааруулгын төлөвийн өнгө (ихэвчлэн шар/улбар шар)"
        },
        "error": {
          "$ref": "#/definitions/HexColor",
          "description": "Алдаа/ноцтой төлөвийн өнгө (ихэвчлэн улаан)"
        },
        "info": {
          "$ref": "#/definitions/HexColor",
          "description": "Мэдээллийн төлөвийн өнгө (ихэвчлэн нил ягаан/цэнхэр)"
        },
        "interactive": {
          "$ref": "#/definitions/HexColor",
          "description": "Харилцан үйлдлийн элементийн өнгө (холбоос, товчлуур)"
        },
        "diffAdd": {
          "$ref": "#/definitions/HexColor",
          "description": "Ялгааны нэмэгдсэн хэсгийн өнгө"
        },
        "diffDelete": {
          "$ref": "#/definitions/HexColor",
          "description": "Ялгааны хасагдсан хэсгийн өнгө"
        }
      }
    },
    "ThemePaletteColors": {
      "type": "object",
      "description": "Бүрэн сэдвийг программын аргаар үүсгэхэд ашигладаг авсаархан утгын палитр",
      "additionalProperties": false,
      "required": ["neutral", "ink", "primary", "success", "warning", "error", "info"],
      "properties": {
        "neutral": {
          "$ref": "#/definitions/HexColor",
          "description": "Саарал өнгийн шатлал үүсгэх үндсэн саармаг өнгө"
        },
        "ink": {
          "$ref": "#/definitions/HexColor",
          "description": "Текст болон хүрээний өнгөний аясыг үүсгэх урд талын эсвэл хүрээний өнгө"
        },
        "primary": {
          "$ref": "#/definitions/HexColor",
          "description": "Брэндийн гадаргуу болон хүчтэй тодотголд ашиглах үндсэн брэндийн өнгө"
        },
        "success": {
          "$ref": "#/definitions/HexColor",
          "description": "Амжилтын төлөвийн өнгө"
        },
        "warning": {
          "$ref": "#/definitions/HexColor",
          "description": "Анхааруулгын төлөвийн өнгө"
        },
        "error": {
          "$ref": "#/definitions/HexColor",
          "description": "Алдаа эсвэл ноцтой төлөвийн өнгө"
        },
        "info": {
          "$ref": "#/definitions/HexColor",
          "description": "Мэдээллийн төлөвийн өнгө"
        },
        "accent": {
          "$ref": "#/definitions/HexColor",
          "description": "Синтакс болон баялаг агуулгад ашиглах нэмэлт тодотголын өнгө"
        },
        "interactive": {
          "$ref": "#/definitions/HexColor",
          "description": "Зориулалтын харилцан үйлдлийн нэмэлт өнгө; заагаагүй бол primary-г ашиглана"
        },
        "diffAdd": {
          "$ref": "#/definitions/HexColor",
          "description": "Ялгааны нэмэгдсэн хэсгийн нэмэлт үр; заагаагүй бол зөөлрүүлсэн success өнгийг ашиглана"
        },
        "diffDelete": {
          "$ref": "#/definitions/HexColor",
          "description": "Ялгааны хасагдсан хэсгийн нэмэлт үр; заагаагүй бол error-г ашиглана"
        }
      }
    },
    "ThemeVariant": {
      "type": "object",
      "description": "Авсаархан палитр эсвэл хуучин үрийн багцтай, нэмэлт хүчингүй болгогчтой сэдвийн хувилбар (цайвар эсвэл бараан)",
      "oneOf": [{ "required": ["seeds"] }, { "required": ["palette"] }],
      "properties": {
        "seeds": {
          "$ref": "#/definitions/ThemeSeedColors",
          "description": "Бүрэн палитр үүсгэхэд ашигладаг хуучин үрийн өнгөнүүд"
        },
        "palette": {
          "$ref": "#/definitions/ThemePaletteColors",
          "description": "Бүх токеныг үүсгэхэд ашигладаг авсаархан палитр"
        },
        "overrides": {
          "type": "object",
          "description": "Дурын CSS хувьсагчийг шууд хүчингүй болгох нэмэлт утгууд (-- угтваргүй)",
          "additionalProperties": {
            "$ref": "#/definitions/ColorValue"
          }
        },
        "v2Overrides": {
          "type": "object",
          "description": "Дурын v2 CSS хувьсагчийг шууд хүчингүй болгох нэмэлт утгууд (-- угтваргүй)",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}

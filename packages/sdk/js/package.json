{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mongolgpt/sdk",
  "version": "0.1.1",
  "description": "MongolGPT сервертэй ажиллах төрөл аюулгүй JavaScript болон TypeScript SDK.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergei10a-rgb/mongolgpt.git",
    "directory": "packages/sdk/js"
  },
  "homepage": "https://docs.mgpt.mn/docs/sdk/",
  "bugs": {
    "url": "https://github.com/sergei10a-rgb/mongolgpt/issues"
  },
  "keywords": [
    "mongolgpt",
    "ai-agent",
    "sdk",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "build": "bun ./script/build.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./v2": "./src/v2/index.ts",
    "./v2/client": "./src/v2/client.ts",
    "./v2/gen/client": "./src/v2/gen/client/index.ts",
    "./v2/server": "./src/v2/server.ts",
    "./v2/types": "./src/v2/gen/types.gen.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tsconfig/node22": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "cross-spawn": "catalog:"
  }
}

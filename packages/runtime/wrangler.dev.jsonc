{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mongolgpt-runtime-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["MONGOLGPT_RUNTIME_SECRET", "MONGOLGPT_RUNTIME_AUTH_SECRET"],
  },
  "ratelimits": [
    {
      "name": "MONGOLGPT_RUNTIME_BURST_LIMITER",
      "namespace_id": "206071801",
      "simple": {
        "limit": 60,
        "period": 10,
      },
    },
    {
      "name": "MONGOLGPT_RUNTIME_RATE_LIMITER",
      "namespace_id": "206071802",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
  ],
  "containers": [
    {
      "class_name": "MongolGPTSandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 5,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "MongolGPTSandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MongolGPTSandbox"],
    },
  ],
}

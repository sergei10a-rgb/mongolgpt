#!/usr/bin/env bash

set -euo pipefail

tag="${GITHUB_REF_NAME:-${1:-}}"
if [[ ! "$tag" =~ ^mongolgpt-github-v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Unexpected MongolGPT GitHub Action tag: ${tag:-<empty>}"
  exit 1
fi

test -f github/action.yml
grep -q 'name: "MongolGPT GitHub Action"' github/action.yml
grep -q 'using: "composite"' github/action.yml

echo "MongolGPT GitHub Action published from immutable tag ${tag}."
